SITES_BIND_ADDRESS=127.0.0.1:3102
# Required: an absolute path on a dedicated persistent local volume.
SITES_DATA_DIR=
# Required: 32–256 visible ASCII characters. Shared only with trusted Platform callers.
SITES_API_TOKEN=
RUST_LOG=info
# Set both origins to enable the separate content listener. Use a different
# origin from the dashboard. Non-loopback origins require HTTPS at your proxy.
SITES_CONTENT_BIND_ADDRESS=127.0.0.1:3103
SITES_CONTENT_ORIGIN=
SITES_DASHBOARD_ORIGIN=

# Optional parent-only Platform SDK (both together); never passed to the JS child.
SITES_PLATFORM_URL=
SITES_PLATFORM_CAPABILITY_TOKEN=

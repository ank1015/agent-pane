PLATFORM_SERVER_BIND_ADDRESS=127.0.0.1:3100
PLATFORM_SERVER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/platform_server
PLATFORM_SERVER_DATABASE_MIN_CONNECTIONS=1
PLATFORM_SERVER_DATABASE_MAX_CONNECTIONS=10
PLATFORM_SERVER_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
PLATFORM_SERVER_EXECUTION_GATEWAY_URL=https://execution.acentric.dev/
PLATFORM_SERVER_EXECUTION_GATEWAY_TOKEN=
PLATFORM_SERVER_EXECUTION_GATEWAY_TIMEOUT_SECONDS=30
PLATFORM_SERVER_LLM_GATEWAY_URL=https://llm.acentric.dev/
PLATFORM_SERVER_LLM_GATEWAY_ADMIN_TOKEN=
PLATFORM_SERVER_LLM_GATEWAY_TIMEOUT_SECONDS=30
RUST_LOG=platform_server=info
# Worker bootstrap credential (at least 32 random characters). Registration only;
# each process supplies its own worker_token and uses it for subsequent calls.
PLATFORM_WORKER_REGISTRATION_TOKEN=
# Separate administrator credential (32–256 random printable ASCII characters).
# Empty disables harness administration and fleet inspection.
PLATFORM_RUNTIME_ADMIN_TOKEN=

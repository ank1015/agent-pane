PLATFORM_URL=http://127.0.0.1:3100
PLATFORM_WORKER_REGISTRATION_TOKEN=
WORKER_BIND_ADDRESS=127.0.0.1:3101
WORKER_CAPACITY=8
WORKER_BUILD_ID=development
RUST_LOG=info
BASIC_CC_TOOLS_ENABLED=false
BASIC_CODEX_TOOLS_ENABLED=false
UNIFIED_EXEC_ONLY_ENABLED=false
# Public GCS bucket; worker needs gcloud and authenticated object-create access.
BASIC_CODEX_IMAGE_BUCKET=
ENVIRONMENTS_ENABLED=false
# Optional public-web research for environments runs.
FIRECRAWL_API_KEY=
LLM_GATEWAY_URL=
LLM_GATEWAY_API_TOKEN=
EXECUTION_GATEWAY_URL=
EXECUTION_GATEWAY_API_TOKEN=
# Opt in only for trusted local development gateways.
GATEWAYS_ALLOW_INSECURE_HTTP=false

# Live site authoring; no execution gateway is required
# when Sites is the only enabled harness. Sites is Platform-owned for all projects.
SITES_ENABLED=false
# Required when SITES_ENABLED=true. Install the browser package and Chromium;
# startup checks that the configured runtime can launch with Chromium's sandbox.
SITES_BROWSER_NODE=/absolute/path/to/node
SITES_BROWSER_SCRIPT=/absolute/path/to/platform/packages/harnesses/sites/browser/runtime.mjs
# Optional operator-selected Playwright browser cache (default is the user cache).
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/playwright-browsers

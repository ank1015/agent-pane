EXECUTION_GATEWAY_BIND_ADDRESS=127.0.0.1:8790
EXECUTION_GATEWAY_DATABASE_URL=postgres://postgres:postgres@localhost/execution_gateway
EXECUTION_GATEWAY_DATABASE_MAX_CONNECTIONS=10
# Must be 32-512 characters with no surrounding whitespace.
EXECUTION_GATEWAY_API_TOKEN=replace-with-a-long-random-token
EXECUTION_GATEWAY_PUBLIC_URL=http://127.0.0.1:8790/
# Development only. Production gateway and daemon connections require TLS.
EXECUTION_GATEWAY_ALLOW_INSECURE_HTTP=true
# Generate with: openssl rand -base64 32
EXECUTION_GATEWAY_VAULT_KEY=replace-with-a-base64-encoded-32-byte-key
EXECUTION_GATEWAY_DEFAULT_HOST_TIMEOUT_SECONDS=3600
EXECUTION_GATEWAY_REGISTRATION_TOKEN_TTL_SECONDS=900
EXECUTION_GATEWAY_REGISTERED_HEARTBEAT_SECONDS=15
EXECUTION_GATEWAY_REGISTERED_OPERATION_TIMEOUT_SECONDS=60
EXECUTION_GATEWAY_REGISTERED_MAX_IN_FLIGHT=64
EXECUTION_GATEWAY_MAX_OPERATIONS_IN_FLIGHT=32
EXECUTION_GATEWAY_MAX_AUTH_FAILURES_PER_MINUTE=30
EXECUTION_GATEWAY_MAX_MACHINE_ENTRY_ATTEMPTS_PER_MINUTE=60
EXECUTION_GATEWAY_E2B_CONTROL_BASE_URL=https://api.e2b.app/
EXECUTION_GATEWAY_E2B_REQUEST_TIMEOUT_SECONDS=60
EXECUTION_GATEWAY_RECONCILE_INTERVAL_MS=1000
EXECUTION_GATEWAY_MAX_REQUEST_BYTES=16777216
RUST_LOG=execution_gateway=info

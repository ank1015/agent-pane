EXECUTION_GATEWAY_BIND_ADDRESS=127.0.0.1:8790
EXECUTION_GATEWAY_DATABASE_URL=postgresql://localhost/execution_gateway
EXECUTION_GATEWAY_DATABASE_MAX_CONNECTIONS=10
EXECUTION_GATEWAY_ADMIN_TOKEN=replace-with-an-admin-token
EXECUTION_GATEWAY_API_TOKEN=replace-with-an-api-token
EXECUTION_GATEWAY_CONTROL_TOKEN=replace-with-a-platform-control-token
EXECUTION_GATEWAY_VAULT_KEY=base64-encoded-32-byte-key
EXECUTION_GATEWAY_DAEMON_WEBSOCKET_URL=ws://127.0.0.1:8790/v1/machines/connect
EXECUTION_GATEWAY_REGISTRATION_TTL_SECONDS=900
EXECUTION_GATEWAY_MAX_REQUEST_BYTES=1048576
RUST_LOG=execution_gateway=info

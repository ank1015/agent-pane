ENVIRONMENT_HARNESS_INSTANCE_ID=environment-local
ENVIRONMENT_HARNESS_MAX_CONCURRENT_TURNS=20
ENVIRONMENT_HARNESS_NATS_URL=nats://127.0.0.1:4222

ENVIRONMENT_HARNESS_AGENT_URL=http://127.0.0.1:8780
ENVIRONMENT_HARNESS_AGENT_TOKEN=
# Optional: when set, environment-harness registers and activates its packaged revision.
ENVIRONMENT_HARNESS_AGENT_CONTROL_TOKEN=
ENVIRONMENT_HARNESS_AGENT_TIMEOUT_SECONDS=30

ENVIRONMENT_HARNESS_LLM_GATEWAY_URL=http://127.0.0.1:3000
ENVIRONMENT_HARNESS_LLM_TIMEOUT_SECONDS=2160
ENVIRONMENT_HARNESS_EXECUTION_GATEWAY_URL=http://127.0.0.1:8790
ENVIRONMENT_HARNESS_EXECUTION_GATEWAY_TOKEN=
ENVIRONMENT_HARNESS_EXECUTION_TIMEOUT_SECONDS=30

ENVIRONMENT_HARNESS_COMMAND_RESULT_TIMEOUT_SECONDS=30
ENVIRONMENT_HARNESS_COMMAND_MAX_RETRIES=3
ENVIRONMENT_HARNESS_COMMAND_RETRY_BASE_MILLISECONDS=250
ENVIRONMENT_HARNESS_COMMAND_RETRY_MAX_SECONDS=10
ENVIRONMENT_HARNESS_DELIVERY_RETRY_SECONDS=5
ENVIRONMENT_HARNESS_PROGRESS_INTERVAL_SECONDS=30
RUST_LOG=environment_harness=info

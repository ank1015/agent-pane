PI_HARNESS_INSTANCE_ID=pi-local
PI_HARNESS_MAX_CONCURRENT_TURNS=20
PI_HARNESS_NATS_URL=nats://127.0.0.1:4222

PI_HARNESS_AGENT_URL=http://127.0.0.1:8780
PI_HARNESS_AGENT_TOKEN=
# Optional: when set, pi-harness registers and activates its packaged revision.
PI_HARNESS_AGENT_CONTROL_TOKEN=
PI_HARNESS_AGENT_TIMEOUT_SECONDS=30

PI_HARNESS_LLM_GATEWAY_URL=http://127.0.0.1:3000
PI_HARNESS_LLM_TIMEOUT_SECONDS=2160
PI_HARNESS_EXECUTION_GATEWAY_URL=http://127.0.0.1:8790
PI_HARNESS_EXECUTION_GATEWAY_TOKEN=
PI_HARNESS_EXECUTION_TIMEOUT_SECONDS=30

PI_HARNESS_COMMAND_RESULT_TIMEOUT_SECONDS=30
PI_HARNESS_COMMAND_MAX_RETRIES=3
PI_HARNESS_COMMAND_RETRY_BASE_MILLISECONDS=250
PI_HARNESS_COMMAND_RETRY_MAX_SECONDS=10
PI_HARNESS_DELIVERY_RETRY_SECONDS=5
PI_HARNESS_PROGRESS_INTERVAL_SECONDS=30
RUST_LOG=pi_harness=info

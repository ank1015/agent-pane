CODEX_HARNESS_INSTANCE_ID=codex-local
CODEX_HARNESS_MAX_CONCURRENT_TURNS=20
CODEX_HARNESS_NATS_URL=nats://127.0.0.1:4222

CODEX_HARNESS_AGENT_URL=http://127.0.0.1:8780
CODEX_HARNESS_AGENT_TOKEN=
# Optional: when set, codex-harness registers and activates its packaged revision.
CODEX_HARNESS_AGENT_CONTROL_TOKEN=
CODEX_HARNESS_AGENT_TIMEOUT_SECONDS=30

CODEX_HARNESS_LLM_GATEWAY_URL=http://127.0.0.1:3000
CODEX_HARNESS_LLM_TIMEOUT_SECONDS=2160

CODEX_HARNESS_EXECUTION_GATEWAY_URL=http://127.0.0.1:8790
CODEX_HARNESS_EXECUTION_GATEWAY_TOKEN=
CODEX_HARNESS_EXECUTION_TIMEOUT_SECONDS=30

CODEX_HARNESS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/codex_harness
CODEX_HARNESS_DATABASE_MAX_CONNECTIONS=10
CODEX_HARNESS_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
# Live V8 sessions are released after this much harness inactivity. Durable
# cell IDs and store/load values remain in PostgreSQL.
CODEX_HARNESS_CODE_MODE_IDLE_TTL_SECONDS=86400
CODEX_HARNESS_TIMEZONE=UTC

CODEX_HARNESS_COMMAND_RESULT_TIMEOUT_SECONDS=30
CODEX_HARNESS_COMMAND_MAX_RETRIES=3
CODEX_HARNESS_COMMAND_RETRY_BASE_MILLISECONDS=250
CODEX_HARNESS_COMMAND_RETRY_MAX_SECONDS=10
CODEX_HARNESS_DELIVERY_RETRY_SECONDS=5
CODEX_HARNESS_PROGRESS_INTERVAL_SECONDS=30
RUST_LOG=codex_harness=info

LLM_GATEWAY_DATABASE_URL=postgresql://localhost/llm_gateway
LLM_GATEWAY_DATABASE_MAX_CONNECTIONS=10
LLM_GATEWAY_DATABASE_MIN_CONNECTIONS=1
LLM_GATEWAY_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
# Generate with: openssl rand -base64 32
LLM_GATEWAY_VAULT_KEY=
# Runtime and admin tokens must each contain at least 32 non-whitespace bytes.
LLM_GATEWAY_API_TOKEN=
LLM_GATEWAY_ADMIN_TOKEN=
LLM_GATEWAY_BIND_ADDRESS=127.0.0.1:3000
LLM_GATEWAY_MAX_CONCURRENT_REQUESTS=32
LLM_GATEWAY_MAX_QUEUED_REQUESTS=64
LLM_GATEWAY_QUEUE_TIMEOUT_SECONDS=120
# Applies only to invalid bearer tokens; successful requests are not rate limited.
LLM_GATEWAY_MAX_AUTH_FAILURES_PER_MINUTE=60
LLM_GATEWAY_MAX_REQUEST_BYTES=67108864
# Must be between 1 and 3600 seconds.
LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=2100
LLM_GATEWAY_CHATGPT_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
LLM_GATEWAY_CHATGPT_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
RUST_LOG=llm_gateway=info
